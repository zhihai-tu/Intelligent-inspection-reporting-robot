# 环境变量配置文件
# 复制此文件为 .env 并填入真实的配置信息

# OpenAI API配置（用于AI内容分析）
# 可以使用OpenAI官方API或兼容的第三方API
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1  # 可选，自定义API端点

# 数据库配置（默认使用SQLite，无需配置）
# DATABASE_URL=sqlite:///./data/database.db

# 应用配置
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
